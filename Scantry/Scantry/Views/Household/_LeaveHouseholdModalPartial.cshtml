@using static Scantry.GCommon.HouseholdMessages
@model Scantry.Core.Models.HouseholdServiceModel

<div class="modal fade" id="leaveHouseholdModal-@Model.HouseholdId" tabindex="-1" aria-labelledby="leaveModalLabel-@Model.HouseholdId" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Leave" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="leaveModalLabel-@Model.HouseholdId">Leave household</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="householdId" value="@Model.HouseholdId" />
                    <p class="fw-semibold">
                        @(Model.HouseholdUsers?.Count == 1 
                            ? LeaveWarningLastUser
                            : LeaveConfirmation)
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, leave</button>
                </div>
            </form>
        </div>
    </div>
</div>