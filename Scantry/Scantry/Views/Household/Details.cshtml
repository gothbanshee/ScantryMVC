@model Scantry.Core.Models.HouseholdServiceModel

@{
	ViewData["Title"] = "Household Details";
}
<partial name="_AlertsPartial" />

<div class="row justify-content-between align-items-center">
	<!-- add an icon later instead of text -->
	<div class="col">
		<a class="btn btn-primary" asp-action="Index">Back</a>
	</div>
	<div class="col text-center">
		<h4>@Model.HouseholdName</h4>
	</div>
	<div class="col text-end">
		<a href="#" onclick="shareHouseholdToken('@Model.AccessToken'); return false;" class="btn btn-outline-warning btn-sm flex-fill py-2 text-center" title="Invite a user">
            <i class="bi bi-share"></i> Invite
        </a>
	</div>

</div>

<hr />

<div class="container my-4">

	<div class="row g-4">
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("All Items", "View and manage all items currently stored in this household.", "AllItems", Model.HouseholdId, "View All", "bi bi-box-seam")' />
		</div>
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("Low-Stock Items", "Quickly see what is running low and needs to be restocked.", "LowStock", Model.HouseholdId, "Check Stock", "bi bi-exclamation-triangle")' />
		</div>
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("Favourite Items", "Your most bookmarked pantry goods.", "Favourites", Model.HouseholdId, "View Favourites", "bi bi-star")' />
		</div>
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("Category View", "Browse items filtered by a single specific category.", "Categories", Model.HouseholdId, "Browse Categories", "bi bi-tags")' />
		</div>
	</div>
</div>



@section Scripts {
	<partial name="_ShareJoinLinkScriptPartial" />
}