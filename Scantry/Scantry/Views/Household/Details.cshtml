@model Scantry.Core.Models.HouseholdServiceModel

@{
	ViewData["Title"] = "Household Details";
}

<div class="row justify-content-between align-items-center">
	<div class="col">
		<a class="btn btn-primary" asp-action="Index" title="Back">
			<i class="bi bi-arrow-left"></i>
		</a>
	</div>
	<div class="col text-center">
		<h4>@Model.HouseholdName</h4>
	</div>
	<div class="col text-end">
		<a href="#" onclick="shareHouseholdToken('@Model.AccessToken'); return false;" class="btn btn-outline-warning btn-sm flex-fill py-2 text-center" title="Invite a user">
            <i class="bi bi-share"></i> Invite
        </a>
	</div>

</div>

<hr />

<div class="container my-4">

	<div class="row g-4">
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("All Items", "View and manage all items currently stored in this household.", "HouseholdProduct", "MyProducts", Model.HouseholdId, Model.HouseholdName, "View All", "bi bi-box-seam")' />
		</div>
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("Low-Stock Items", "Quickly see what is running low and needs to be restocked.", "HouseholdProduct", "LowStockProducts", Model.HouseholdId, Model.HouseholdName, "Check Stock", "bi bi-exclamation-triangle")' />
		</div>
		<div class="col-md-6">
			<partial name="_DashboardCardPartial" model='("Favourite Items", "Your most bookmarked pantry goods.", "HouseholdProduct", "Favourites", Model.HouseholdId, Model.HouseholdName, "View Favourites", "bi bi-star")' />
		</div>
		<div class="col-md-6">
			@{
				string expiringDescription = $"Browse items that are expiring in the next {Scantry.GCommon.Constants.EntityValidationConstants.ExpirationDateCheck} days.";
			}
			<partial name="_DashboardCardPartial" model='("Expiring View", expiringDescription, "HouseholdProduct", "Expiring", Model.HouseholdId, Model.HouseholdName, "Check expiring items", "bi bi-tags")' />
		</div>
	</div>
</div>



@section Scripts {
	<partial name="_ShareJoinLinkScriptPartial" />
}