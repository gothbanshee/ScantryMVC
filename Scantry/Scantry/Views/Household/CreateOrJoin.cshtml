@model Scantry.Core.Models.HouseholdServiceModel

@{
	ViewData["Title"] = "Create or join household";
}
<partial name="_AlertsPartial" />

<div class="d-flex flex-column justify-content-between align-items-center" style="min-height: 75vh;">
	
	<!-- Top spacing buffer or empty div if needed, helps push the middle content down -->
	<div></div>
<div class="d-flex flex-column flex-lg-row align-items-center justify-content-center gap-5 p-3 w-100">
	<div class="flex-fill" style="max-width: 400px;">
		<h2>Create your new household...</h2>
		<form asp-action="Create" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="mb-3">
				<label asp-for="HouseholdName" class="form-label">Household Name</label>
				<input asp-for="HouseholdName" class="form-control" placeholder="Enter household name..." />
				<span asp-validation-for="HouseholdName" class="text-danger"></span>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary">Create</button>
			</div>
		</form>
	</div>

	<hr class="my-3 d-lg-none w-100">
	<div class="vr d-none d-lg-block" style="min-height: 200px;"></div>

	<div class="flex-fill d-flex flex-column text-end" style="max-width: 400px;">
		<h2>...or join an existing one!</h2>
		<form asp-action="Join" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="mb-3">
				<label asp-for="AccessToken" class="form-label">Access Token</label>
				<input asp-for="AccessToken" class="form-control text-end" placeholder="Enter access token..." />
				<span asp-validation-for="AccessToken" class="text-danger"></span>
			</div>
			<div class="d-flex gap-2 justify-content-end">
				<button type="submit" class="btn btn-primary">Join</button>
			</div>
		</form>
	</div>
</div>
<div class="pb-3 text-center w-100">
	<a asp-action="Index" class="btn btn-warning">Back to my households</a>
</div>
</div>


@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}