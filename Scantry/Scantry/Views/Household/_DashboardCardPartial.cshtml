@model (string Title, string Description, string Controller, string Action, int HouseholdId, string HouseholdName, string ButtonText, string IconClass)

<div class="card h-100 shadow border-1">
    <div class="card-body d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center mb-3">
                <i class="@Model.IconClass fs-4 text-danger me-2"></i>
                <h5 class="card-title mb-0">@Model.Title</h5>
            </div>
            <p class="card-text text-muted">@Model.Description</p>
        </div>
        <div class="mt-3">
            <a asp-controller ="@Model.Controller"
               asp-action="@Model.Action"
               asp-route-id="@Model.HouseholdId"
               asp-route-householdName="@Model.HouseholdName"
               class="btn btn-brown w-100">
                @Model.ButtonText
            </a>
        </div>
    </div>
</div>