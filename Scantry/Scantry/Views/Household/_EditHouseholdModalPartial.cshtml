@model Scantry.Core.Models.HouseholdServiceModel

<div class="modal fade" id="editModal-@Model.HouseholdId" tabindex="-1" aria-labelledby="editModalLabel-@Model.HouseholdId" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form asp-action="Edit" method="post">
				<div class="modal-header">
					<h5 class="modal-title" id="editModalLabel-@Model.HouseholdId">Rename Household</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<input type="hidden" name="householdId" value="@Model.HouseholdId" />
					<div class="mb-3">
						<label for="householdName-@Model.HouseholdId" class="form-label">Household Name</label>
						<input type="text" class="form-control" id="householdName-@Model.HouseholdId" name="householdName" value="@Model.HouseholdName" required />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary">Save Changes</button>
				</div>
			</form>
		</div>
	</div>
</div>