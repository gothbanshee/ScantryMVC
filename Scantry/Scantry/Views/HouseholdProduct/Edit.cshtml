@model Scantry.Core.Models.HouseholdProductEditModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <!-- Header -->
                <div class="text-center mb-4">
                    <h3 class="text-primary fw-bold mb-1">
                        <i class="bi bi-pencil-square"></i> Edit Product
                    </h3>
                    <h5 class="text-muted mb-0">@Model.ProductName</h5>
                    <small class="text-muted">@Model.ProductTypeAndVariant</small>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="HouseholdProductId" />
                    <input type="hidden" asp-for="HouseholdId" />
                    <input type="hidden" asp-for="HouseholdName" />
                    <input type="hidden" asp-for="ProductName" />
                    <input type="hidden" asp-for="ProductTypeAndVariant" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <!-- Category -->
                    <div class="mb-3 text-start">
                        <label asp-for="Category" class="form-label fw-bold"></label>
                        <select asp-for="Category" asp-items="ViewBag.Categories" class="form-select" placeholder="@Model.Category"></select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <!-- Current Quantity -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CurrentQuantity" class="form-label fw-semibold">Quantity</label>
                            <input asp-for="CurrentQuantity" class="form-control" type="number" />
                            <span asp-validation-for="CurrentQuantity" class="text-danger small"></span>
                        </div>

                        <!-- Minimum Threshold -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinimumThreshold" class="form-label fw-semibold">Minimum Threshold</label>
                            <input asp-for="MinimumThreshold" class="form-control" type="number" />
                            <span asp-validation-for="MinimumThreshold" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Expiration Date -->
                    <div class="mb-4">
                        <label asp-for="ExpirationDate" class="form-label fw-semibold">Expiration Date</label>
                        <input asp-for="ExpirationDate" class="form-control" type="date" />
                        <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="MyProducts"
                            asp-route-id="@Model.HouseholdId"
                            asp-route-householdName="@Model.HouseholdName"
                            class="btn btn-warning px-4">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}