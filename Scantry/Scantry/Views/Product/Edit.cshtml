@model Scantry.Core.Models.ProductServiceModel

@{
    ViewData["Title"] = "Edit Catalog Product";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 bg-white">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4 text-primary fw-bold">
                        <i class="bi bi-pencil-square"></i> Edit Global Product
                    </h2>

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="ProductId" />

                        <div class="mb-3">
                            <label asp-for="Barcode" class="form-label fw-semibold"></label>
                            <input asp-for="Barcode" class="form-control" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Brand" class="form-label fw-semibold"></label>
                                <input asp-for="Brand" class="form-control" />
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Model" class="form-label fw-semibold"></label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ProductType" class="form-label fw-semibold"></label>
                                <input asp-for="ProductType" class="form-control" />
                                <span asp-validation-for="ProductType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Variant" class="form-label fw-semibold"></label>
                                <input asp-for="Variant" class="form-control" />
                                <span asp-validation-for="Variant" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SizeValue" class="form-label fw-semibold"></label>
                                <input asp-for="SizeValue" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="SizeValue" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="SizeUnit" class="form-label fw-semibold"></label>
                                <select asp-for="SizeUnit" asp-items="ViewBag.SizeUnits" class="form-select"></select>
                                <span asp-validation-for="SizeUnit" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Update Product</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}