@model IEnumerable<Scantry.Core.Models.ProductServiceModel>

@{
    ViewData["Title"] = "Global Product Catalog";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">
            <i class="bi bi-collection"></i> Product Catalog
        </h2>
        <a asp-controller="HouseholdProduct" asp-action="Scan" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Product
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
            <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
            No products found in the global catalog.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card shadow-lg border-0 h-100">
                        <div class="card-body px-3 pt-3 pb-2">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title text-primary fw-bold mb-0 flex-grow-1 lh-sm" title="@product.Brand @product.Model">
                                    @product.Brand @product.Model
                                </h5>
                            </div>
                            <h6 class="card-subtitle text-muted small mb-2">
                                @product.ProductType (@(product.Variant ?? "Standard"))
                            </h6>

                            <ul class="list-group list-group-flush small mb-0">
                                <li class="list-group-item d-flex justify-content-between py-1 px-0 bg-transparent">
                                    <span class="fw-semibold">Barcode:</span>
                                    <span>@product.Barcode</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between py-1 px-0 bg-transparent">
                                    <span class="fw-semibold">Size:</span>
                                    <span>@product.SizeValue @product.SizeUnit</span>
                                </li>
                            </ul>
                        </div>

                        <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3 d-flex justify-content-center align-items-center">
                            <a asp-controller="Product"
                               asp-action="Edit"
                               asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-outline-primary px-3 py-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>