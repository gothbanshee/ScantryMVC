{
  "ConnectionStrings": {
    "DefaultConnection": "Server=MIRAS\\SQLEXPRESS;Database=Scantry;Trusted_Connection=True;MultipleActiveResultSets=True;Encrypt=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityOptions": {
    "SignIn": {
      "RequireConfirmedAccount": true,
      "RequireConfirmedEmail": true,
      "RequireConfirmedPhoneNumber": false
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 3,
      "RequiredUniqueChars": 1,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": 1,
      "MaxFailedAccessAttempts": 255
    }
  }
}
